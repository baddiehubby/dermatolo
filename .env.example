# Public site origin (no trailing slash). Required for canonical URLs, sitemap.xml,
# and absolute OG/JSON-LD URLs. Set after you have a real domain.
# Example: https://moneyperfume.pk
NEXT_PUBLIC_SITE_URL=

# Customer reviews (copy to .env.local for local use; never commit real values)
#
# Storage: Upstash Redis over REST. On Vercel, adding the Upstash Redis integration
# (Project > Storage / Marketplace > Upstash Redis) injects KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; those names are accepted as well.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for /admin/reviews (Manage reviews: delete abusive reviews). Use a long random
# string. The page stays disabled while this is empty.
ADMIN_SECRET=

# Optional: salt for hashing visitor IPs in the rate limiter (defaults to ADMIN_SECRET).
# REVIEWS_HASH_SALT=

# Optional override of the storage choice: redis | file | off.
# Default: Redis if the variables above are set; otherwise, anywhere that is NOT Vercel
# (both `next dev` and `next start`), reviews are saved to .data/reviews.json with a
# console warning. On Vercel the file store is never used (read-only filesystem), so
# without Redis variables the form answers 503 and the server log names what is missing.
# REVIEWS_STORE=
